{
  "name": "airtrailer-website",
  "private": true,
  "type": "module",
  "description": "Statische website van Airtrailer met kennisbank en configurator.",
  "scripts": {
    "build": "node scripts/build-kennisbank.mjs && node scripts/build-configurator.mjs",
    "check": "node scripts/build-kennisbank.mjs --check && node scripts/build-configurator.mjs --check",
    "test": "node --test \"tests/*.test.js\"",
    "dev": "node scripts/dev-server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "nodemailer": "^10.6.1"
  }
}
